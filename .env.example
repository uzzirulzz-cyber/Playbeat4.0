# Public source catalog used by the server-side five-minute refresh agent.
PLAYBEAT_SOURCE_URL=https://playbeatdigital.store
# Required by the Vercel Cron GET endpoint; use a long random value.
CRON_SECRET=replace-with-a-long-random-secret
# PlayBeat Digital — Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit your real `.env` file — it is gitignored.

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite path (local dev only — overridden by MongoDB in production)
DATABASE_URL="file:./dev.db"

# MongoDB Atlas connection string.
# Get this from MongoDB Atlas → "Connect" → "Drivers" → Node.js
# Format: mongodb+srv://<username>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority&appName=<cluster>
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB_NAME="playbeat"

# ─── AI / LLM ────────────────────────────────────────────────────────────────
# Gemini API key — auto-injected by AI Studio at runtime.
GEMINI_API_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL of the deployed app.
APP_URL="http://localhost:3000"

# ─── G2G Authorized Partner API ───────────────────────────────────────────────
G2G_API_KEY=""
G2G_API_SECRET=""
G2G_PARTNER_ENDPOINT="https://api.g2g.com/v1"

# ─── Payment Gateways (Server-side Only) ──────────────────────────────────────
# IMPORTANT: Never expose these to the browser. Use them only in API routes / server.ts.
STRIPE_SECRET_KEY=""
LEMON_SQUEEZY_API_KEY=""
PAYPAL_CLIENT_SECRET=""
JAZZCASH_MERCHANT_KEY=""
EASYPAISA_STORE_ID=""

# ─── Security ─────────────────────────────────────────────────────────────────
# Used to sign JWTs and session cookies. Generate a strong random string for production:
#   openssl rand -hex 32
JWT_SECRET="generate-a-strong-random-secret-here"

# ─── Social OAuth (server-side only) ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
OAUTH_CALLBACK_URL="http://localhost:3000/api/auth/oauth/callback"

# ─── PostgreSQL (Neon) ───────────────────────────────────────────────────────
# Get this from Neon dashboard → Connection Details
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
